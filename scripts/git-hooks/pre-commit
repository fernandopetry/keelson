#!/usr/bin/env bash
# pre-commit — guarda do topo da main (decisão 4.63) + guarda de qualidade (decisão 4.83)
#
# Parte 1 (4.63): sessões paralelas colidem em numeração de decisão (§4.x) e na versão
# do plugin. Se origin/main tem commits que este HEAD não tem, o commit é bloqueado.
#
# Parte 2 (4.83): o commit que toca a parte mecânica prova a qualidade ANTES de entrar —
# bash -n em todo script staged; suíte do grafo quando graph.sh/fixtures mudam; checks
# de release (versões sincronizadas, CHANGELOG, MIRRORS) quando os arquivos de release
# mudam. Commit que não toca nada disso não paga nada.
#
# Doutrina dos hooks do repo: bash 3.2-compatível, fallback gracioso — indisponibilidade
# (sem remoto, sem rede, suíte ausente) avisa e segue; só a violação REAL bloqueia.
# Escapes conscientes: KEELSON_SKIP_MAIN_CHECK=1 · KEELSON_SKIP_TESTS=1
# Ativação (uma vez por clone): git config core.hooksPath scripts/git-hooks

set -u

# ============ Parte 1: guarda do topo da main (decisão 4.63) ============
# Função com return (nunca exit em caso não-aplicável): um "não se aplica" aqui não
# pode engolir a Parte 2.
main_guard() {
  # Detached HEAD (rebase/cherry-pick em andamento) → não interferir
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return 0
  [ "$branch" = "main" ] || return 0

  # Sem remoto → nada a conferir
  git remote get-url origin >/dev/null 2>&1 || return 0

  # Fetch barato; sem rede → best-effort (confere contra o último fetch conhecido)
  if ! git fetch origin main --quiet 2>/dev/null; then
    echo "[keelson pre-commit] aviso: fetch de origin/main falhou (sem rede?) — conferindo contra o último fetch local." >&2
  fi

  git rev-parse --verify --quiet origin/main >/dev/null 2>&1 || return 0

  behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
  behind=${behind:-0}

  if [ "$behind" -gt 0 ] 2>/dev/null; then
    echo "" >&2
    echo "[keelson pre-commit] BLOQUEADO: origin/main tem $behind commit(s) que este HEAD não tem:" >&2
    git log --oneline HEAD..origin/main 2>/dev/null | sed 's/^/    /' >&2
    echo "" >&2
    echo "  Sessão paralela já publicou — numerar decisão/bumpar versão agora colide (caso real: duas '4.60')." >&2
    echo "  Integre antes de commitar:" >&2
    echo "    git pull --rebase origin main" >&2
    echo "  e confira o topo de docs/_meta/decisions.md (próximo §4.x livre) e a versão em .claude-plugin/plugin.json." >&2
    echo "  Escape consciente: KEELSON_SKIP_MAIN_CHECK=1 git commit ..." >&2
    return 1
  fi
  return 0
}

if [ "${KEELSON_SKIP_MAIN_CHECK:-0}" != "1" ]; then
  main_guard || exit 1
fi

# ============ Parte 2: guarda de qualidade (decisão 4.83) ============
[ "${KEELSON_SKIP_TESTS:-0}" = "1" ] && exit 0

# Nomes de arquivo do repo não têm espaço (convenção kebab dos templates) — o for é seguro.
staged="$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)"
[ -n "$staged" ] || exit 0

# bash -n em todo script staged: sintaxe quebrada nunca entra
for f in $staged; do
  case "$f" in
    *.sh|scripts/git-hooks/*)
      [ -f "$f" ] || continue
      if ! bash -n "$f" 2>/dev/null; then
        echo "[keelson pre-commit] BLOQUEADO: bash -n falhou em $f:" >&2
        bash -n "$f" 2>&1 | sed 's/^/    /' >&2
        exit 1
      fi ;;
  esac
done

# Suíte do grafo: obrigatória quando o motor ou as fixtures mudam
if printf '%s\n' "$staged" | grep -qE '^scripts/(graph\.sh$|tests/graph/)'; then
  if [ -f scripts/tests/graph/run.sh ]; then
    echo "[keelson pre-commit] graph.sh/suíte no commit — rodando scripts/tests/graph/run.sh" >&2
    if ! out="$(bash scripts/tests/graph/run.sh 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte do grafo falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, regenere os expected" >&2
      echo "  (fixture nova acompanha check novo). Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/graph/run.sh ausente — suíte não conferida." >&2
  fi
fi

# Suíte do map: obrigatória quando o motor ou as fixtures mudam (4.104)
if printf '%s\n' "$staged" | grep -qE '^scripts/(map-check\.sh$|tests/map/)'; then
  if [ -f scripts/tests/map/run.sh ]; then
    echo "[keelson pre-commit] map-check.sh/suíte no commit — rodando scripts/tests/map/run.sh" >&2
    if ! out="$(bash scripts/tests/map/run.sh 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte do map falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, regenere os expected" >&2
      echo "  (fixture nova acompanha check novo). Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/map/run.sh ausente — suíte não conferida." >&2
  fi
fi

# Checks de release: obrigatórios quando os arquivos de release mudam
if printf '%s\n' "$staged" | grep -qE '^(\.claude-plugin/|CHANGELOG\.md$|README\.md$|scripts/publish-wiki\.sh$)'; then
  if [ -f scripts/check-release.sh ]; then
    if ! out="$(bash scripts/check-release.sh 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: checks de release falharam (versões/CHANGELOG/MIRRORS acima)." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  else
    echo "[keelson pre-commit] aviso: scripts/check-release.sh ausente — release não conferido." >&2
  fi
fi

exit 0
