#!/usr/bin/env bash
# pre-commit — guarda do topo da main (decisão 4.63) + guarda de qualidade (decisão 4.83)
#
# Parte 1 (4.63): sessões paralelas colidem em numeração de decisão (§4.x) e na versão
# do plugin. Se origin/main tem commits que este HEAD não tem, o commit é bloqueado.
#
# Parte 2 (4.83): o commit que toca a parte mecânica prova a qualidade ANTES de entrar —
# bash -n em todo script staged; suíte do grafo quando graph.sh/fixtures mudam; checks
# de release (versões sincronizadas, CHANGELOG, MIRRORS) quando os arquivos de release
# mudam. Commit que não toca nada disso não paga nada.
#
# Doutrina dos hooks do repo: bash 3.2-compatível, fallback gracioso — indisponibilidade
# (sem remoto, sem rede, suíte ausente) avisa e segue; só a violação REAL bloqueia.
# Escapes conscientes: KEELSON_SKIP_MAIN_CHECK=1 · KEELSON_SKIP_TESTS=1
# Ativação (uma vez por clone): git config core.hooksPath scripts/git-hooks

set -u

# ============ Parte 1: guarda do topo da main (decisão 4.63) ============
# Função com return (nunca exit em caso não-aplicável): um "não se aplica" aqui não
# pode engolir a Parte 2.
main_guard() {
  # Detached HEAD (rebase/cherry-pick em andamento) → não interferir
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return 0
  [ "$branch" = "main" ] || return 0

  # Sem remoto → nada a conferir
  git remote get-url origin >/dev/null 2>&1 || return 0

  # Fetch barato; sem rede → best-effort (confere contra o último fetch conhecido)
  if ! git fetch origin main --quiet 2>/dev/null; then
    echo "[keelson pre-commit] aviso: fetch de origin/main falhou (sem rede?) — conferindo contra o último fetch local." >&2
  fi

  git rev-parse --verify --quiet origin/main >/dev/null 2>&1 || return 0

  behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
  behind=${behind:-0}

  if [ "$behind" -gt 0 ] 2>/dev/null; then
    echo "" >&2
    echo "[keelson pre-commit] BLOQUEADO: origin/main tem $behind commit(s) que este HEAD não tem:" >&2
    git log --oneline HEAD..origin/main 2>/dev/null | sed 's/^/    /' >&2
    echo "" >&2
    echo "  Sessão paralela já publicou — numerar decisão/bumpar versão agora colide (caso real: duas '4.60')." >&2
    echo "  Integre antes de commitar:" >&2
    echo "    git pull --rebase origin main" >&2
    echo "  e confira o topo de docs/_meta/decisions.md (próximo §4.x livre) e a versão em .claude-plugin/plugin.json." >&2
    echo "  Escape consciente: KEELSON_SKIP_MAIN_CHECK=1 git commit ..." >&2
    return 1
  fi
  return 0
}

if [ "${KEELSON_SKIP_MAIN_CHECK:-0}" != "1" ]; then
  main_guard || exit 1
fi

# ============ Parte 2: guarda de qualidade (decisão 4.83) ============
[ "${KEELSON_SKIP_TESTS:-0}" = "1" ] && exit 0

# Nomes de arquivo do repo não têm espaço (convenção kebab dos templates) — o for é seguro.
staged="$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)"
[ -n "$staged" ] || exit 0

# bash -n em todo script staged: sintaxe quebrada nunca entra
for f in $staged; do
  case "$f" in
    *.sh|scripts/git-hooks/*)
      [ -f "$f" ] || continue
      if ! bash -n "$f" 2>/dev/null; then
        echo "[keelson pre-commit] BLOQUEADO: bash -n falhou em $f:" >&2
        bash -n "$f" 2>&1 | sed 's/^/    /' >&2
        exit 1
      fi ;;
  esac
done

# Análise estática (shellcheck) nos scripts staged (4.208), além da sintaxe do bash -n.
# Fallback gracioso: binário ausente → aviso e segue (o CI roda em todos os arquivos e
# é a prova real, como na portabilidade Linux). Falso positivo consciente → diretiva
# "# shellcheck disable=SCxxxx" no local, nunca desligar o passo.
sc_files=""
for f in $staged; do
  case "$f" in
    *.sh|scripts/git-hooks/*)
      [ -f "$f" ] && sc_files="$sc_files $f" ;;
  esac
done
if [ -n "$sc_files" ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    # sc_files é lista separada por espaço (nomes do repo não têm espaço) — expansão intencional
    # shellcheck disable=SC2086
    if ! out="$(shellcheck $sc_files 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: shellcheck acusou nos scripts staged (4.208)." >&2
      echo "  Corrija — ou, para falso positivo consciente, suprima com diretiva no local." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  else
    echo "[keelson pre-commit] aviso: shellcheck ausente — análise estática fica para o CI (4.208)." >&2
  fi
fi

# Frontmatter YAML válido (4.211 — reincidência em campo: GitHub quebra a renderização).
# Qualquer .md staged → varredura completa (barata); parser estrito ausente → o próprio
# check degrada com aviso e o CI é a prova real.
if printf '%s\n' "$staged" | grep -q '\.md$'; then
  if [ -f scripts/check-frontmatter.sh ]; then
    if ! out="$(bash scripts/check-frontmatter.sh 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: frontmatter inválido (4.211) — corrija (aspas no valor com ': ')." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  fi
fi

# Bit de execução dos scripts do pacote: hooks.json invoca hooks/*.sh DIRETAMENTE (sem
# prefixo bash) e 644 no índice vira "Permission denied" silencioso no consumidor (4.180);
# a 2ª ocorrência da classe (scripts/next-id.sh 644 no pacote 0.96.0) estendeu o check a
# todo script invocável do pacote (4.195). Confere o índice inteiro — custo zero.
hx_bad="$(git ls-files -s -- 'hooks/*.sh' 'scripts/*.sh' 'scripts/git-hooks/*' 2>/dev/null | grep -v '^100755' || true)"
if [ -n "$hx_bad" ]; then
  echo "[keelson pre-commit] BLOQUEADO: script sem bit de execução no índice — no pacote instalado vira Permission denied (4.180/4.195):" >&2
  printf '%s\n' "$hx_bad" | sed 's/^/    /' >&2
  echo "  Corrija: chmod +x <arquivos> && git add" >&2
  echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
  exit 1
fi

# Suíte do grafo: obrigatória quando o motor ou as fixtures mudam
if printf '%s\n' "$staged" | grep -qE '^scripts/(graph\.sh$|tests/graph/)'; then
  if [ -f scripts/tests/graph/run.sh ]; then
    echo "[keelson pre-commit] graph.sh/suíte no commit — rodando scripts/tests/graph/run.sh" >&2
    if ! out="$(bash scripts/tests/graph/run.sh 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte do grafo falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, regenere os expected" >&2
      echo "  (fixture nova acompanha check novo). Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/graph/run.sh ausente — suíte não conferida." >&2
  fi
fi

# Suíte do stale-background-guard: obrigatória quando o hook ou a suíte mudam (4.206)
if printf '%s\n' "$staged" | grep -qE '^(hooks/stale-background-guard\.sh$|scripts/tests/stale-bg/)'; then
  if [ -f scripts/tests/stale-bg/run.sh ]; then
    echo "[keelson pre-commit] stale-background-guard/suíte no commit — rodando scripts/tests/stale-bg/run.sh" >&2
    if ! out="$(bash scripts/tests/stale-bg/run.sh 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte do stale-background-guard falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, ajuste as asserções" >&2
      echo "  (fixture nova acompanha critério novo). Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/stale-bg/run.sh ausente — suíte não conferida." >&2
  fi
fi

# Suíte do map: obrigatória quando o motor ou as fixtures mudam (4.104)
if printf '%s\n' "$staged" | grep -qE '^scripts/(map-check\.sh$|tests/map/)'; then
  if [ -f scripts/tests/map/run.sh ]; then
    echo "[keelson pre-commit] map-check.sh/suíte no commit — rodando scripts/tests/map/run.sh" >&2
    if ! out="$(bash scripts/tests/map/run.sh 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte do map falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, regenere os expected" >&2
      echo "  (fixture nova acompanha check novo). Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/map/run.sh ausente — suíte não conferida." >&2
  fi
fi

# Paridade MCP dos agents: check quando agents/ ou o motor mudam; suíte quando o motor muda (4.105)
if printf '%s\n' "$staged" | grep -qE '^(agents/[^/]+\.md$|scripts/check-agents\.sh$|scripts/tests/agents-mcp/)'; then
  if [ -f scripts/check-agents.sh ]; then
    if ! out="$(bash scripts/check-agents.sh 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: paridade MCP dos agents falhou (4.105)." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  else
    echo "[keelson pre-commit] aviso: scripts/check-agents.sh ausente — paridade MCP não conferida." >&2
  fi
  if printf '%s\n' "$staged" | grep -qE '^scripts/(check-agents\.sh$|tests/agents-mcp/)'; then
    if [ -f scripts/tests/agents-mcp/run.sh ]; then
      echo "[keelson pre-commit] check-agents.sh/suíte no commit — rodando scripts/tests/agents-mcp/run.sh" >&2
      if ! out="$(bash scripts/tests/agents-mcp/run.sh 2>&1)"; then
        printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
        echo "[keelson pre-commit] BLOQUEADO: suíte do check-agents falhou (acima, resumida)." >&2
        echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
        exit 1
      fi
      printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
    else
      echo "[keelson pre-commit] aviso: scripts/tests/agents-mcp/run.sh ausente — suíte não conferida." >&2
    fi
  fi
fi

# Sincronização de comandos/agents: check quando as fontes mudam; suíte quando o motor muda (4.147)
if printf '%s\n' "$staged" | grep -qE '^(commands/[^/]+\.md$|agents/[^/]+\.md$|README\.md$|docs/_meta/method-guide\.md$|templates/CLAUDE\.keelson-block\.md$|scripts/check-sync\.sh$|scripts/tests/sync/)'; then
  if [ -f scripts/check-sync.sh ]; then
    if ! out="$(bash scripts/check-sync.sh 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: sincronização de comandos/agents falhou (4.147)." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  else
    echo "[keelson pre-commit] aviso: scripts/check-sync.sh ausente — sincronização não conferida." >&2
  fi
  if printf '%s\n' "$staged" | grep -qE '^scripts/(check-sync\.sh$|tests/sync/)'; then
    if [ -f scripts/tests/sync/run.sh ]; then
      echo "[keelson pre-commit] check-sync.sh/suíte no commit — rodando scripts/tests/sync/run.sh" >&2
      if ! out="$(bash scripts/tests/sync/run.sh 2>&1)"; then
        printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
        echo "[keelson pre-commit] BLOQUEADO: suíte do check-sync falhou (acima, resumida)." >&2
        echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
        exit 1
      fi
      printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
    else
      echo "[keelson pre-commit] aviso: scripts/tests/sync/run.sh ausente — suíte não conferida." >&2
    fi
  fi
fi

# Suítes da camada mecânica (4.151/4.152): motor ou fixtures no commit → a suíte roda.
# ficha.sh também dispara a do diff-facts (que a consome). Cada suíte roda no máximo 1×.
run_suite() {
  sdir="$1"
  case " ${SUITES_RODADAS:-} " in *" $sdir "*) return 0 ;; esac
  SUITES_RODADAS="${SUITES_RODADAS:-} $sdir"
  if [ -f "scripts/tests/$sdir/run.sh" ]; then
    echo "[keelson pre-commit] motor/fixtures no commit — rodando scripts/tests/$sdir/run.sh" >&2
    if ! out="$(bash "scripts/tests/$sdir/run.sh" 2>&1)"; then
      printf '%s\n' "$out" | tail -25 | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: suíte $sdir falhou (acima, resumida)." >&2
      echo "  Corrija — ou, se a mudança de comportamento é intencional, regenere os expected." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
    printf '%s\n' "$out" | tail -1 | sed 's/^/[keelson pre-commit] /' >&2
  else
    echo "[keelson pre-commit] aviso: scripts/tests/$sdir/run.sh ausente — suíte não conferida." >&2
  fi
}
for par in "ficha:ficha diff-facts" "next-id:next-id" "index-check:index" \
           "diff-facts:diff-facts" "artifact-lint:artifact-lint" \
           "run-state:run-state" "ledger:ledger" \
           "init-selfcheck:init-selfcheck" "probe-env:probe-env" \
           "epic-state:epic-state" "handoff-scan:handoff-scan" \
           "legacy-move:legacy-move" "postmortem-facts:postmortem-facts" \
           "edge-diff:edge-diff" "e2e-coverage:e2e-coverage" \
           "update:release" "check-release:release" "check-refs:refs" \
           "check-frontmatter:frontmatter" "context-cost:context-cost"; do
  motor="${par%%:*}"; suites="${par#*:}"
  dirs_re="$(printf '%s' "$suites" | sed 's/ /|/g')"
  if printf '%s\n' "$staged" | grep -qE "^scripts/($motor\.sh\$|tests/($dirs_re)/)"; then
    for s in $suites; do run_suite "$s"; done
  fi
done

# Checks de release: obrigatórios quando os arquivos de release mudam
if printf '%s\n' "$staged" | grep -qE '^(\.claude-plugin/|CHANGELOG\.md$|README\.md$|scripts/publish-wiki\.sh$)'; then
  if [ -f scripts/check-release.sh ]; then
    if ! out="$(bash scripts/check-release.sh 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      echo "[keelson pre-commit] BLOQUEADO: checks de release falharam (versões/CHANGELOG/MIRRORS acima)." >&2
      echo "  Escape consciente: KEELSON_SKIP_TESTS=1" >&2
      exit 1
    fi
  else
    echo "[keelson pre-commit] aviso: scripts/check-release.sh ausente — release não conferido." >&2
  fi
fi

exit 0
